# Anthropic API key (Phase 2 — news impact tagging & narrative)
# Get at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Anthropic model id used for AI calls
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# environment | log_level
ENVIRONMENT=development
LOG_LEVEL=INFO

# How many years of history to backfill on cold start
BACKFILL_YEARS=2

# Intraday quote polling cadence in minutes
INTRADAY_POLL_MINUTES=5

# Scheduler timezone
SCHEDULER_TIMEZONE=Europe/London
